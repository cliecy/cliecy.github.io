{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "scripts/**/*",
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true
  }
}
