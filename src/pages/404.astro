---
import BaseLayout from '../layouts/BaseLayout.astro';
import UiText from '../components/UiText.astro';
---

<BaseLayout title="页面未找到" titleEn="Page not found" description="找不到你请求的页面。" descriptionEn="The requested page could not be found." noindex>
  <section class="not-found container">
    <p class="not-found__code">404</p>
    <p class="eyebrow"><UiText zh="页面未找到" en="Page not found" /></p>
    <h1><UiText zh="这里什么也没有。" en="Nothing lives here." /></h1>
    <p><UiText zh="页面可能已经移动，或者从未存在过。" en="The page may have moved, or it may never have existed." /></p>
    <a href="/"><UiText zh="返回首页" en="Return home" /> <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    display: flex;
    min-height: 68vh;
    align-items: flex-start;
    justify-content: center;
    flex-direction: column;
    overflow: hidden;
  }

  .not-found__code {
    margin: 0 0 1rem;
    color: var(--faint);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .not-found h1 {
    margin: 0;
    font-size: clamp(2.8rem, 8vw, 6rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .not-found > p:not(.eyebrow, .not-found__code) {
    margin: 1.25rem 0;
    color: var(--muted);
  }

  .not-found > a {
    color: var(--accent);
    font-weight: 700;
  }
</style>
