---
import { getCollection } from 'astro:content';

import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import UiText from '../components/UiText.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { publishedOnly, sortByNewest, visibleEntries } from '../lib/content';
import { getProjects } from '../lib/projects';

const profiles = await getCollection('site');
const profile = profiles[0];
if (!profile) throw new Error('Site profile is missing.');

const allPosts = await getCollection('blog');
const latestPosts = sortByNewest(visibleEntries(allPosts, import.meta.env.DEV)).slice(0, 3);
const allProjects = await getProjects();
const featuredProjects = publishedOnly(allProjects)
  .filter((project) => project.data.featured)
  .sort((left, right) => left.data.order - right.data.order);
---

<BaseLayout
  description={profile.data.seoDescription}
  descriptionEn={profile.data.seoDescriptionEn}
>
  <section class="hero container" aria-labelledby="hero-title">
    <p class="eyebrow"><UiText zh="开发与创作" en="Developer & Creator" /></p>
    <h1 id="hero-title"><UiText zh="你好，我是 CLIECY。" en="Hi, I'm CLIECY." /></h1>
    <p class="hero__introduction">
      <UiText zh={profile.data.introduction} en={profile.data.introductionEn} />
    </p>
    <div class="hero__actions">
      <a class="button button--primary" href="/blog/"><UiText zh="阅读文章" en="Read the writing" /> <span aria-hidden="true">→</span></a>
      <a class="button" href={profile.data.githubUrl} target="_blank" rel="noreferrer"><UiText zh="查看 GitHub" en="View GitHub" /> <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  {latestPosts.length > 0 && (
    <section class="home-section container" aria-labelledby="writing-title">
      <div class="section-heading">
        <h2 id="writing-title"><UiText zh="最近文章" en="Latest writing" /></h2>
        <a href="/blog/"><UiText zh="查看全部" en="View all" /> <span aria-hidden="true">→</span></a>
      </div>
      <div class="card-grid">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}

  {featuredProjects.length > 0 && (
    <section class="home-section container" aria-labelledby="projects-title">
      <div class="section-heading">
        <h2 id="projects-title"><UiText zh="精选项目" en="Selected projects" /></h2>
        <a href="/projects/"><UiText zh="查看全部" en="View all" /> <span aria-hidden="true">→</span></a>
      </div>
      <div class="card-grid card-grid--projects">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    max-width: 880px;
    padding-block: clamp(5rem, 13vw, 9rem);
    border-bottom: 1px solid var(--border);
  }

  .hero h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 680;
    line-height: 1.08;
    letter-spacing: -0.055em;
  }

  .hero__introduction {
    max-width: 39rem;
    margin: 1.6rem 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.8;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding-inline: 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.35rem;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }

  .button:hover {
    border-color: var(--text);
    color: var(--text);
  }

  .button--primary {
    border-color: var(--text);
    background: var(--text);
    color: var(--background);
  }

  .button--primary:hover {
    background: #d8d6d0;
    color: var(--background);
  }

  .home-section {
    padding-block: clamp(4rem, 9vw, 6.5rem);
  }

  .home-section + .home-section {
    border-top: 1px solid var(--border);
  }

  .card-grid--projects {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 720px) {
    .hero {
      padding-block: 4.5rem;
    }

    .hero h1 {
      font-size: clamp(2.8rem, 14vw, 4.4rem);
    }

    .card-grid--projects {
      grid-template-columns: 1fr;
    }
  }
</style>
