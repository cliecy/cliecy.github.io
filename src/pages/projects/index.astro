---
import ProjectCard from '../../components/ProjectCard.astro';
import UiText from '../../components/UiText.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { visibleEntries } from '../../lib/content';
import { getProjects } from '../../lib/projects';

const projects = visibleEntries(await getProjects(), import.meta.env.DEV).sort(
  (left, right) => left.data.order - right.data.order,
);
---

<BaseLayout title="项目" titleEn="Projects" description="CLIECY 的项目与实验。" descriptionEn="Projects and experiments by CLIECY.">
  <div class="container">
    <header class="page-header">
      <p class="eyebrow"><UiText zh="作品" en="Selected work" /></p>
      <h1><UiText zh="项目" en="Projects" /></h1>
      <p class="page-header__description"><UiText zh="一些实用工具、实验和正在持续完善的作品。" en="Useful tools, experiments, and work in progress." /></p>
    </header>

    {projects.length > 0 ? (
      <div class="card-grid projects-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    ) : (
      <div class="empty-state"><p><UiText zh="项目正在准备中。" en="Projects are being prepared." /></p></div>
    )}
  </div>
</BaseLayout>

<style>
  .projects-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 720px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
