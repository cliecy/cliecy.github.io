---
import type { CollectionEntry } from 'astro:content';

import UiText from './UiText.astro';
import { entrySlug } from '../lib/content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const slug = entrySlug(project.id);
---

<article class="content-card project-card">
  {project.data.image && (
    <a class="project-card__image" href={`/projects/${slug}/`} tabindex="-1" aria-hidden="true">
      <img src={project.data.image} alt="" loading="lazy" decoding="async" />
    </a>
  )}
  <div class="content-card__meta">
    <span><UiText zh="项目" en="Project" /></span>
    {project.data.draft && <span class="draft-badge"><UiText zh="草稿" en="Draft" /></span>}
  </div>
  <h2><a href={`/projects/${slug}/`}>{project.data.title}</a></h2>
  <p>{project.data.description}</p>
  {project.data.tags.length > 0 && (
    <ul class="tag-list" aria-label="技术" data-aria-zh="技术" data-aria-en="Technologies">
      {project.data.tags.map((tag) => <li><span>{tag}</span></li>)}
    </ul>
  )}
</article>
